"X-Domain: worx\n"
msgid "Worx"
msgstr "Worx"

msgid "Space saved by Worx"
msgstr "مقدار حافظه‌ای که Worx صرفه‌جویی کرده"

msgid "Not optimized"
msgstr "بهینه‌شده نیست"

msgid "Reprocess"
msgstr "پردازش مجدد"

msgid "%1$d images - %2$d optimized (%3$d%%)"
msgstr "%1$d تصویر · %2$d بهینه‌شده (%3$d٪)"

msgid "Settings"
msgstr "تنظیمات"

msgid "Processing..."
msgstr "در حال پردازش…"

msgid "Done"
msgstr "انجام شد"

msgid "Error"
msgstr "خطا"

msgid "Permission denied."
msgstr "دسترسی مجاز نیست."

msgid "Invalid attachment."
msgstr "پیوست نامعتبر است."

msgid "None detected"
msgstr "کسی تشخیص داده نشد"

msgid "Attached file not found on disk."
msgstr "فایل پیوست روی دیسک پیدا نشد."

msgid "No image engine (Imagick/GD) available on this server."
msgstr "هیچ موتور پردازش تصویر (Imagick/GD) روی این سرور در دسترس نیست."

msgid "Unsupported image format."
msgstr "فرمت تصویر پشتیبانی نمی‌شود."

msgid "Could not move the WebP file into place."
msgstr "انتقال فایل WebP به محل نهایی ناموفق بود."

msgid "Source file is missing."
msgstr "فایل مبدأ وجود ندارد."

msgid "Destination must differ from source."
msgstr "مقصد باید با فایل مبدأ متفاوت باشد."

msgid "WebP encoding failed - no output file produced."
msgstr "فشرده‌سازی WebP ناموفق بود — هیچ فایل خروجی ساخته نشد."

msgid "Worx Setup Wizard"
msgstr "ویزارد راه‌اندازی Worx"

msgid "You do not have permission to save these settings."
msgstr "شما اجازه‌ی ذخیره‌ی این تنظیمات را ندارید."

msgid "Zero-lag WebP pipeline - Smart watermark - Modern media hub"
msgstr "پایپ‌لاین WebP بدون تاخیر · واترمارک هوشمند · هاب رسانه مدرن"

msgid "Image engine: %s"
msgstr "موتور پردازش تصویر: %s"

msgid "Settings saved. New uploads are now processed automatically."
msgstr "تنظیمات ذخیره شد. آپلودهای جدید از این به بعد به‌صورت خودکار پردازش می‌شوند."

msgid "Live watermark preview"
msgstr "پیش‌نمایش زنده واترمارک"

msgid "This preview mirrors the 9-anchor matrix used during upload."
msgstr "این پیش‌نمایش دقیقاً همان ماتریس ۹ جایی است که هنگام آپلود استفاده می‌شود."

msgid "Demo product"
msgstr "محصول نمایشی"

msgid "Watermark position"
msgstr "موقعیت واترمارک"

msgid "Watermark opacity"
msgstr "شفافیت واترمارک"

msgid "Watermark image"
msgstr "تصویر واترمارک"

msgid "Default WX logo"
msgstr "لوگوی پیش‌فرض WX"

msgid "Enable watermark on upload"
msgstr "اعمال واترمارک هنگام آپلود"

msgid "Optimization engine"
msgstr "موتور بهینه‌سازی"

msgid "Convert uploads to WebP automatically"
msgstr "تبدیل خودکار آپلودها به WebP"

msgid "WebP quality"
msgstr "کیفیت WebP"

msgid "100 = maximum quality (true lossless on servers with Imagick)."
msgstr "۱۰۰ = حداکثر کیفیت (لوسلس واقعی روی سرورهای مجهز به Imagick)."

msgid "Maximum width"
msgstr "حداکثر عرض"

msgid "Uploads wider than this are resized down. Use 0 to disable resizing."
msgstr "آپلودهای عریض‌تر از این مقدار، کوچک‌شده می‌شوند. برای غیرفعال‌کردن ریسایز، ۰ وارد کنید."

msgid "Delete the original file after WebP is generated"
msgstr "حذف فایل اصلی پس از تولید WebP"

msgid "When off, a copy is kept next to the WebP file with the \"-original\" suffix."
msgstr "در حالت غیرفعال، یک کپی با پسوند «-original» کنار فایل WebP نگه داشته می‌شود."

msgid "Save & finish"
msgstr "ذخیره و پایان"

msgid "Open media hub"
msgstr "باز کردن هاب رسانه"

msgid "Powered by obsifox studio"
msgstr "ساخته‌شده توسط obsifox studio"

